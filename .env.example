# ==============================================================================
# RoamAI Group Companion - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="development"

# LLM Selection (options: "gemini", "openai", "groq")
DEFAULT_LLM_PROVIDER="gemini"

# Google Gemini (Recommended for free tier with multimodal vision)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI (Alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Groq (Alternative for ultra-fast Llama 3 inference)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Messaging Platforms
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_BOT_USERNAME=""

# WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="roamai_companion_verify_token"
WHATSAPP_APP_SECRET=""

# Passive listener: off, shadow (observe without offers), or live
ROAMAI_LISTENER_MODE="shadow"
# Comma-separated platform:account-id:chat-id entries; empty means no passive platform groups
ROAMAI_ALLOWED_GROUPS=""
ROAMAI_DEBOUNCE_SECONDS=10
ROAMAI_OFFER_COOLDOWN_SECONDS=300

# Storage
SQLITE_DB_PATH="roamai_companion.db"
CHECKPOINT_DB_PATH="agent_memory.db"
SERPAPI_KEY=""

# Langfuse Observability & Tracing
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_HOST="https://cloud.langfuse.com"

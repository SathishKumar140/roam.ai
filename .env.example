# ==============================================================================
# Ambient Group Companion - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="development"

# LLM Selection (options: "gemini", "openai", "groq")
DEFAULT_LLM_PROVIDER="gemini"

# Google Gemini (Recommended for free tier with multimodal vision)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI (Alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Groq (Alternative for ultra-fast Llama 3 inference)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Messaging Platforms
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="ambient_companion_verify_token"

# Storage
SQLITE_DB_PATH="ambient_companion.db"
CHECKPOINT_DB_PATH="agent_memory.db"

# Langfuse Observability & Tracing
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_HOST="https://cloud.langfuse.com"
